38284>>>    Procedure SetActionButtons
38287>>>        tWebNavigateData NavigateData
38287>>>        tWebNavigateData NavigateData
38287>>>        Boolean bHasRecord
38287>>>        Handle hoDD
38287>>>
38287>>>        Get Server to hoDD
38288>>>        Get GetNavigateData to NavigateData
38289>>>        Get HasRecord of hoDD to bHasRecord
38290>>>
38290>>>        // let's hide all buttons and then Show the ones we want
38290>>>        WebSet pbRender of oEditBtn to False
38291>>>        WebSet pbRender of oSaveBtn to False
38292>>>        WebSet pbRender of oCancelChangesBtn to False
38293>>>        WebSet pbRender of oDeleteBtn to False
38294>>>
38294>>>        If (NavigateData.bReadOnly) Begin
38296>>>            WebSet pbRender of oEditBtn to True
38297>>>        End
38297>>>>
38297>>>        Else Begin
38298>>>            WebSet pbRender of oSaveBtn to True
38299>>>            WebSet pbRender of oCancelChangesBtn to True
38300>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38301>>>        End
38301>>>>
38301>>>    End_Procedure
38302>>>
38302>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38305>>>        // Close after save
38305>>>        Send NavigateClose Self
38306>>>    End_Procedure
