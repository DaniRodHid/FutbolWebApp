38312>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38315>>>        Case Begin
38315>>>            Case (NavigateData.eNavigateType = nfFromMain)
38317>>>                // If from main, this is a propbably a main file Select to Zoom.
38317>>>                Case Break
38318>>>
38318>>>            Case (NavigateData.eNavigateType = nfFromParent)
38321>>>                // If from parent, this is a constrained drill down.
38321>>>                Case Break
38322>>>
38322>>>            Case (NavigateData.eNavigateType = nfFromChild)
38325>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38325>>>                Case Break
38326>>>
38326>>>            Case Else // must be nfUndefined
38326>>>
38326>>>        Case End
38326>>>
38326>>>        Send SetActionButtons
38327>>>
38327>>>    End_Procedure
38328>>>
38328>>>End_Object 
