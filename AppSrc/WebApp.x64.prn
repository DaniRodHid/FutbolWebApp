37883>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37886>>>        Case Begin
37886>>>            Case (NavigateData.eNavigateType = nfFromMain)
37888>>>                // If from main, this is a propbably a main file Select to Zoom.
37888>>>                Case Break
37889>>>
37889>>>            Case (NavigateData.eNavigateType = nfFromParent)
37892>>>                // If from parent, this is a constrained drill down.
37892>>>                Case Break
37893>>>
37893>>>            Case (NavigateData.eNavigateType = nfFromChild)
37896>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37896>>>                Case Break
37897>>>
37897>>>            Case Else // must be nfUndefined
37897>>>
37897>>>        Case End
37897>>>
37897>>>        Send SetActionButtons
37898>>>
37898>>>    End_Procedure
37899>>>
37899>>>End_Object 
