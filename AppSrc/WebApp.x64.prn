38906>>>        WebSet pbRender of oSaveBtn to False
38907>>>        WebSet pbRender of oCancelChangesBtn to False
38908>>>        WebSet pbRender of oDeleteBtn to False
38909>>>
38909>>>        If (NavigateData.bReadOnly) Begin
38911>>>            WebSet pbRender of oEditBtn to True
38912>>>        End
38912>>>>
38912>>>        Else Begin
