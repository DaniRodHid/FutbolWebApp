37820>>>    Procedure SetActionButtons
37823>>>        tWebNavigateData NavigateData
37823>>>        tWebNavigateData NavigateData
37823>>>        Boolean bHasRecord
37823>>>        Handle hoDD
37823>>>
37823>>>        Get Server to hoDD
37824>>>        Get GetNavigateData to NavigateData
37825>>>        Get HasRecord of hoDD to bHasRecord
37826>>>
37826>>>        // let's hide all buttons and then Show the ones we want
37826>>>        WebSet pbRender of oEditBtn to False
37827>>>        WebSet pbRender of oSaveBtn to False
37828>>>        WebSet pbRender of oCancelChangesBtn to False
37829>>>        WebSet pbRender of oDeleteBtn to False
37830>>>
37830>>>        If (NavigateData.bReadOnly) Begin
37832>>>            WebSet pbRender of oEditBtn to True
37833>>>        End
37833>>>>
37833>>>        Else Begin
37834>>>            WebSet pbRender of oSaveBtn to True
37835>>>            WebSet pbRender of oCancelChangesBtn to True
37836>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37837>>>        End
37837>>>>
37837>>>    End_Procedure
