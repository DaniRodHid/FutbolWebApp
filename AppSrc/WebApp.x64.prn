37853>>>                Case Break
37854>>>
37854>>>            Case (NavigateData.eNavigateType = nfFromParent)
37857>>>                // If from parent, this is a constrained drill down.
37857>>>                Case Break
37858>>>
37858>>>            Case (NavigateData.eNavigateType = nfFromChild)
37861>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37861>>>                Case Break
37862>>>
37862>>>            Case Else // must be nfUndefined
37862>>>
37862>>>        Case End
37862>>>
37862>>>        Send SetActionButtons
37863>>>
37863>>>    End_Procedure
