37855>>>    Procedure SetActionButtons
37858>>>        tWebNavigateData NavigateData
37858>>>        tWebNavigateData NavigateData
37858>>>        Boolean bHasRecord
37858>>>        Handle hoDD
37858>>>
37858>>>        Get Server to hoDD
37859>>>        Get GetNavigateData to NavigateData
37860>>>        Get HasRecord of hoDD to bHasRecord
37861>>>
37861>>>        // let's hide all buttons and then Show the ones we want
37861>>>        WebSet pbRender of oEditBtn to False
37862>>>        WebSet pbRender of oSaveBtn to False
37863>>>        WebSet pbRender of oCancelChangesBtn to False
37864>>>        WebSet pbRender of oDeleteBtn to False
37865>>>
37865>>>        If (NavigateData.bReadOnly) Begin
37867>>>            WebSet pbRender of oEditBtn to True
37868>>>        End
37868>>>>
37868>>>        Else Begin
37869>>>            WebSet pbRender of oSaveBtn to True
37870>>>            WebSet pbRender of oCancelChangesBtn to True
37871>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37872>>>        End
37872>>>>
37872>>>    End_Procedure
37873>>>
37873>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
37876>>>        // Close after save
37876>>>        Send NavigateClose Self
37877>>>    End_Procedure
37878>>>
37878>>>    // this will close the view after a delete
37878>>>    Procedure OnViewDeleted Handle hoDDO
37881>>>        Send NavigateClose Self
37882>>>    End_Procedure
