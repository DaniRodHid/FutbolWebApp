38278>>>
38278>>>        // let's hide all buttons and then Show the ones we want
38278>>>        WebSet pbRender of oEditBtn to False
38279>>>        WebSet pbRender of oSaveBtn to False
38280>>>        WebSet pbRender of oCancelChangesBtn to False
38281>>>        WebSet pbRender of oDeleteBtn to False
38282>>>
38282>>>        If (NavigateData.bReadOnly) Begin
38284>>>            WebSet pbRender of oEditBtn to True
38285>>>        End
38285>>>>
38285>>>        Else Begin
38286>>>            WebSet pbRender of oSaveBtn to True
38287>>>            WebSet pbRender of oCancelChangesBtn to True
38288>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38289>>>        End
38289>>>>
